#!/bin/bash
# lid-caffeinate — keep the Mac awake EVEN WITH THE LID CLOSED for N minutes,
# then automatically restore normal sleep behavior.
#
# Usage:
#   lid-caffeinate          # stay awake 60 min (default)
#   lid-caffeinate 45       # stay awake 45 min
#   lid-caffeinate 90       # stay awake 90 min (max 240)
#   lid-caffeinate --help   # this text
#
# Failsafes:
#   - Auto-restores when the timer expires
#   - Auto-restores early if battery drops to <= 20% (only while on battery)
#   - Ctrl+C restores immediately (trap)
#   - Refuses runs longer than 240 min

set -uo pipefail

MINUTES="${1:-60}"
MAX_MINUTES=240
BATTERY_FLOOR=20   # restore early if battery at/below this %

usage() {
  cat <<EOF
lid-caffeinate — keep your Mac awake EVEN WITH THE LID CLOSED.

Usage:
  lid-caffeinate [minutes]     default 60, max ${MAX_MINUTES}

Failsafes:
  auto-restores on timer expiry, at <= ${BATTERY_FLOOR}% battery, or Ctrl+C
EOF
}

if [[ "${MINUTES}" == "-h" || "${MINUTES}" == "--help" ]]; then
  usage
  exit 0
fi

# Strict numeric validation ("08" would otherwise explode as octal)
if [[ ! "${MINUTES}" =~ ^[0-9]+$ ]]; then
  echo "Error: minutes must be a whole number, got '${MINUTES}'" >&2
  usage >&2
  exit 1
fi
MINUTES=$((10#${MINUTES}))

if (( MINUTES < 1 || MINUTES > MAX_MINUTES )); then
  echo "Usage: lid-caffeinate [minutes 1-${MAX_MINUTES}]" >&2
  exit 1
fi

# Re-exec as root so the timer + trap survive any sudo-timeout weirdness
if [[ $EUID -ne 0 ]]; then
  exec sudo "$0" "$MINUTES"
fi

restore() {
  trap - INT TERM EXIT   # we ARE the shutdown handler; don't fire twice
  pmset -b disablesleep 0
  pmset -c disablesleep 0
  echo ""
  echo "✅ Sleep re-enabled — lid behaves normally again. Safe to bag/sleep."
  osascript -e "display notification \"Sleep re-enabled after ${MINUTES} min. Lid back to normal.\" with title \"lid-caffeinate done\"" 2>/dev/null || true
  exit 0
}
trap restore INT TERM EXIT

on_battery() {
  pmset -g batt | grep -q "Battery Power"
}

battery_pct() {
  pmset -g batt | grep -oE '[0-9]+%' | head -1 | tr -d '%'
}

END_TIME=$(date -v+"${MINUTES}"M "+%H:%M")
BATT_NOW=$(battery_pct)

echo "🔥 lid-caffeinate: staying awake WITH LID CLOSED for ${MINUTES} min (until ${END_TIME})"
if [[ -n "${BATT_NOW}" ]] && on_battery; then
  echo "   Battery now: ${BATT_NOW}%  |  will bail early at ${BATTERY_FLOOR}%"
else
  echo "   On AC / no battery — battery failsafe off."
fi
echo "   Close the lid whenever. Ctrl+C = end early (safely restores)."

# Prevent lid-close sleep on both battery and charger
pmset -b disablesleep 1
pmset -c disablesleep 1

# Timer loop (checks battery once a minute; first check is immediate)
END_AT=$(( SECONDS + MINUTES * 60 ))
while (( SECONDS < END_AT )); do
  if on_battery; then
    BATT=$(battery_pct)
    if [[ -n "${BATT}" ]] && (( BATT <= BATTERY_FLOOR )); then
      echo "🔋 Battery at ${BATT}% — restoring early so the machine doesn't die bag-warm."
      break
    fi
  fi
  sleep 60
done

restore
